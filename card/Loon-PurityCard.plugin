#!name = 节点纯净度详情（卡片版）
#!desc = 在节点页选中节点运行后，直接弹出 HTML 详情卡片：纯净评分、住宅/机房/广播 IP 判定、欺诈分与风险等级。数据源 IPPure + ipinfo。
#!author = WorkBuddy
#!homepage = https://github.com/leeby9699/leeby
#!icon = https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Available_1.png
#!date = 2026-11-16
#!tag = 网络工具,节点检测
#!type = normal
#!loon_version = 3.5.1(983)

# ─────────────────────────────────────────────────────────────
# 语法版本：Loon 3.5.1 (983) 起的新版 Script 语法。
# 3.2.1 – 3.5.0 请改用 legacy/Loon-PurityCard.plugin。
# 脚本对 Loon(generic) 与 QX(event-interaction) 通用，无需修改。
# ─────────────────────────────────────────────────────────────

[Rule]
# 检测域名走代理；脚本内已显式绑定节点，这里只是兜底
DOMAIN,ippure.com,PROXY
DOMAIN,ipinfo.io,PROXY

[Script]
# Loon：首页「脚本」→ 选择节点 → 运行，直接弹出详情卡片
generic then script("https://cdn.jsdelivr.net/gh/leeby9699/leeby@main/card/purity-card.js") with tag="节点纯净度详情", img_url="checkmark.shield.fill.system", timeout=60, enable=true
