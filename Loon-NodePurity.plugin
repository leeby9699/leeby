#!name = 节点纯净度检测
#!desc = 三源交叉检测出口 IP 的纯净度：识别机房 / 代理 / VPN / Tor、欺诈分与广播 IP，输出 0-100 评分与使用建议。可从节点页对单个节点单独检测。
#!author = WorkBuddy
#!homepage = https://github.com/leeby9699/leeby
#!icon = https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Available_1.png
#!date = 2026-11-16
#!tag = 网络工具,节点检测
#!loon_version = 3.2.1(734)

# ─────────────────────────────────────────────────────────────
# 脚本地址已配好，直接导入即可使用。
# 若日后地址失效（例如托管到期），把下面 2 处 script-path 换成自己的
# purity.js 直链即可，写法见同目录 README.md。
# ─────────────────────────────────────────────────────────────

[Rule]
# 让检测请求走代理出口；脚本内已显式绑定节点，这里只是兜底
DOMAIN,ip-api.com,PROXY
DOMAIN,ipinfo.io,PROXY
DOMAIN,ip.sb,PROXY
DOMAIN,scamalytics.com,PROXY

[Script]
# 手动检测：Loon 首页 →「脚本」→ 选择节点后运行；不选节点则检测当前出口
generic script-path=https://cdn.jsdelivr.net/gh/leeby9699/leeby@main/purity.js,tag=节点纯净度检测,timeout=60,img-url=https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Available_1.png,enable=true

# 每日巡检：默认关闭。想要定时监控就把 enable 改成 true，并按需修改阈值
cron "0 9 * * *" script-path=https://cdn.jsdelivr.net/gh/leeby9699/leeby@main/purity.js,tag=纯净度 · 每日巡检,timeout=60,enable=false,argument="mode=patrol&threshold=55"
