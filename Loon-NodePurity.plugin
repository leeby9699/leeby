#!name = 节点纯净度检测
#!desc = 三源交叉检测出口 IP 的纯净度：识别机房 / 代理 / VPN / Tor、欺诈分与广播 IP，输出 0-100 评分与使用建议。可从节点页对单个节点单独检测。
#!author = WorkBuddy
#!homepage = https://github.com/leeby9699/leeby
#!icon = https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Available_1.png
#!date = 2026-11-16
#!tag = 网络工具,节点检测
#!type = normal
#!loon_version = 3.5.1(983)

# ─────────────────────────────────────────────────────────────
# 语法版本：Loon 3.5.1 (983) 起的新版 Script 语法。
# 3.2.1 – 3.5.0 请改用 legacy/Loon-NodePurity.plugin。
# 脚本地址已配好，导入即可使用。
# ─────────────────────────────────────────────────────────────

[Rule]
# 让检测请求走代理出口；脚本内已显式绑定节点，这里只是兜底
DOMAIN,ip-api.com,PROXY
DOMAIN,ipinfo.io,PROXY
DOMAIN,ip.sb,PROXY
DOMAIN,scamalytics.com,PROXY

[Script]
# 手动检测：Loon 首页 →「脚本」→ 选节点后运行；不选节点则检测当前出口
generic then script("https://cdn.jsdelivr.net/gh/leeby9699/leeby@main/purity.js") with tag="节点纯净度检测", img_url="shield.lefthalf.filled.system", timeout=60, enable=true

# 每日巡检：默认关闭。把 enable 改成 true 即启用，threshold 为告警阈值
cron "0 9 * * *" then script("https://cdn.jsdelivr.net/gh/leeby9699/leeby@main/purity.js", "mode=patrol&threshold=55") with tag="纯净度 · 每日巡检", timeout=60, enable=false
